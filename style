*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Segoe UI,sans-serif;
}

body{

height:100vh;

display:flex;
justify-content:center;
align-items:center;

background:linear-gradient(135deg,#3b82f6,#9333ea);

overflow:hidden;

}

.hide{
display:none;
}

#login{

width:100%;
display:flex;
justify-content:center;
align-items:center;

}

.box{

background:rgba(255,255,255,.18);

backdrop-filter:blur(18px);

padding:40px;

border-radius:25px;

width:350px;

text-align:center;

box-shadow:0 20px 50px rgba(0,0,0,.2);

animation:fade .7s;

}

.box h1{

color:white;
margin-bottom:15px;

}

.box p{

color:white;
margin-bottom:20px;

}

input{

width:100%;
padding:15px;

border:none;

border-radius:12px;

margin-bottom:20px;

font-size:16px;

outline:none;

}

button{

padding:14px 30px;

border:none;

border-radius:12px;

background:#fff;

cursor:pointer;

font-size:16px;

font-weight:bold;

transition:.3s;

}

button:hover{

transform:scale(1.05);

}

#calendar{

background:white;

width:850px;

padding:30px;

border-radius:25px;

box-shadow:0 15px 50px rgba(0,0,0,.2);

animation:fade .7s;

}

header{

display:flex;

justify-content:space-between;

align-items:center;

margin-bottom:30px;

}

.month{

display:flex;
align-items:center;
gap:20px;

}

.month button{

background:#3b82f6;
color:white;

}

.days{

display:grid;

grid-template-columns:repeat(7,1fr);

font-weight:bold;

margin-bottom:10px;

text-align:center;

}

#dates{

display:grid;

grid-template-columns:repeat(7,1fr);

gap:10px;

}

.day{

height:80px;

display:flex;

justify-content:center;
align-items:center;

border-radius:15px;

background:#f3f4f6;

transition:.3s;

cursor:pointer;

}

.day:hover{

background:#3b82f6;

color:white;

transform:translateY(-5px);

}

.today{

background:#9333ea;

color:white;

}

@keyframes fade{

from{
opacity:0;
transform:translateY(40px);
}

to{

opacity:1;
transform:translateY(0);

}

}
